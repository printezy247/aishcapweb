# Supabase — only used by the email capture form (table: subscribers).
# Leave blank in development; the form will show a "not configured" message.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional privacy-respecting pageview counter (Plausible, cookieless).
# Leave blank to load no analytics at all.
VITE_PLAUSIBLE_DOMAIN=

# Server-only (Vercel function api/quotes.ts). Never prefix with VITE_.
# Free key from https://twelvedata.com (800 credits/day; the route uses ~480).
QUOTES_API_KEY=
# twelvedata (default) | finnhub
QUOTES_PROVIDER=
